# Server-side MaSe booking destination used by /book and /zh/book.
# This value is not rendered as a public website link. Keep production configuration in Vercel.
MASE_BOOKING_URL=https://clients.mase.cloud/shopDetail?custId=MENDBEAUTY&compId=579514834843697153

# Optional Google Analytics 4 measurement ID (for example G-XXXXXXXXXX).
# Analytics remains disabled unless this value is configured. Even when it is
# configured, the website does not load Google Analytics until the visitor
# explicitly allows optional analytics.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Private Marketing Portal authentication (server-side only).
# Google OAuth must use the callback URL:
# https://mendbeauty.com.au/api/auth/callback/google
# AUTH_SECRET=
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# MARKETING_PORTAL_ALLOWED_EMAIL=hello@mendbeauty.com.au
